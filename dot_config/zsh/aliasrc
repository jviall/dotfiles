#
# AWS profile management functions
function awsp() {
  if [ -z "$1" ]; then
    echo "Usage: awsp <profile-name>"
    echo "Available profiles:"
    aws configure list-profiles
    echo "Current profile:"
    echo "'$AWS_PROFILE'"
    return 1
  fi
  # Check if profile exists
  if ! aws configure list-profiles | grep -q "^$1$"; then
    echo "Error: Profile '$1' not found"
    echo "Available profiles:"
    aws configure list-profiles
    return 1
  fi
  local profile_name="$1"
  export AWS_PROFILE="$profile_name"
  echo "Switched to profile: '$1'"
}
alias awswho='aws sts get-caller-identity'
alias awslogin='aws sso login'

alias aider="aider --config ~/.config/.aider.conf.yml --env-file ~/.config/.env-aider"

# default git to git status if there's no args (overrides ohmyzsh g=git alias)
function g() {
  if [[ -z "${*//[[:space:]]/}" ]]; then
    git status
  else
    git "$@"
  fi
}

# Tmux
