alias greup=gfo main:main && grbm

# default git to git status if there's no args (overrides ohmyzsh g=git alias)
unalias g 2>/dev/null
function g() {
  if [[ -z "${*//[[:space:]]/}" ]]; then
    git status
  else
    git "$@"
  fi
}

# a "git help" that lets me fuzzy search for all the configured aliases and their expanded commands
function ghp() {
  alias | grep "^g" | grep "git" | fzf --prompt="git alias> "
}

# Tmux
alias tkill="tmux kill-session -t"
alias tlist="tmux list-sessions"
alias tattach="tmux attach"
alias ta="tattach"
alias tmz="tmux source-file ~/.config/zsh/.zshrc \; respawn-pane -k -t 0 \; respawn-pane -k -t 1" # source zshrc for all visible panes

# eza/ls
alias ls="eza -ax  --icons"
alias ll="eza -albh --icons --git"
alias lr="eza -TL 3 --icons"

# yazi
function y() {
  if command -v yazi &>/dev/null; then
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
      builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
  else
    return 1
  fi
}

# chezmoi
alias cheza="chezmoi apply"
alias chezd="chezmoi diff"
alias chezl="chezmoi re-add ~/.config/nvim/lazy-lock.json ~/.config/nvim/lazyvim.json"
