{{- $machineKey := includeTemplate "machine-ssh-key" . | trim -}}
[user]
	name = jviall
	email = jviall@pm.me
{{- if $machineKey }}
  # This machine's personal key (see .chezmoitemplates/machine-ssh-key), served by 1Password.
  # Must match a key registered as a *Signing* key on GitHub, or commits show Unverified.
  signingkey = key::{{ onepasswordRead $machineKey }}
{{- else }}
  signingkey = ~/.ssh/github
{{- end }}
[core]
  editor = nvim
	excludesfile = ~/.config/git/ignore
{{- if eq .chezmoi.os "windows" }}
  # Git Bash's MSYS ssh cannot open Windows named pipes, so it cannot reach
  # the 1Password SSH agent; native Windows OpenSSH can.
  sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}
[push]
  autoSetupRemote = true
[commit]
  gpgsign = true
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
{{- if eq .chezmoi.os "windows" }}
  # MSYS ssh-keygen cannot reach the 1Password agent named pipe
  program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
{{- else if and (eq .chezmoi.os "darwin") $machineKey }}
  # ssh-keygen ignores ~/.ssh/config's IdentityAgent; 1Password's signer talks to its agent
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- end }}
[pull]
	rebase = true
[ghq]
  root = ~/git
[init]
	defaultBranch = main
